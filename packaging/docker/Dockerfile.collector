# The Guacamole collector bundle, baked into an otelcol-contrib image.
# Build:  docker build -f packaging/docker/Dockerfile.collector -t guacamole-otelcol:0.2.0 .
# (build context = repo root)
#
# Set OTLP_EXPORTER_ENDPOINT at runtime to your backend. On containers there is no
# journald; mount container logs and switch the journald receiver to a filelog one,
# or ship guacd logs to this collector over OTLP — see packaging/openshift/README.md.
FROM otel/opentelemetry-collector-contrib@sha256:1175b03003053962012f5a231f5567f66a3e8fdb960c7835c0e48f7aa1555806
COPY collector/otelcol-guacamole.yaml /etc/otelcol/config.yaml
CMD ["--config=/etc/otelcol/config.yaml"]
